---
import { getCollection } from 'astro:content';
import CategoryPage from '../components/CategoryPage.astro';
import { visibleArticles } from '../lib/articles';
const articles = visibleArticles(await getCollection('articles')).filter((a) => a.data.category === '台灣與世界');
---

<CategoryPage
  title="台灣與世界"
  description="從台灣出發，探索世界"
  articles={articles}
  heroImage="/images/headers/tataocheng.jpg"
  heroCaption="從台北大橋北望七星山與大屯群山，台灣 - Jul 2022"
/>