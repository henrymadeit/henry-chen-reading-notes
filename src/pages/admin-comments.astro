---
import AdminLayout from '../layouts/AdminLayout.astro';
import { getCollection } from 'astro:content';
import { visibleArticles } from '../lib/articles';

const titles = Object.fromEntries(
  visibleArticles(await getCollection('articles')).map(
    a => [a.id, a.data.title]
  )
);
---

<AdminLayout title="回覆留言">
  <div id="admin-comments" data-titles={JSON.stringify(titles)}>
    <section class="pending-comments" aria-labelledby="pending-heading">
      <div class="pending-heading-row">
        <h2 id="pending-heading">
          未回覆留言 <span data-pending-count></span>
        </h2>
        <button type="button" data-pending-refresh>重新整理</button>
      </div>

      <p data-pending-status role="status">載入中……</p>
      <div data-pending-items></div>
      <button type="button" data-pending-more hidden>載入更多</button>
    </section>

    <section aria-labelledby="all-comments-heading">
      <h2 id="all-comments-heading">全部留言</h2>

      <p class="admin-note">
        最新留言與回覆排在前面。可以直接回覆，也可以前往文章查看完整對話。版主只能修改自己的文字。
      </p>

      <div data-items></div>
      <p data-status role="status"></p>

      <div class="admin-actions">
        <button type="button" data-prev>上一頁</button>
        <span data-page></span>
        <button type="button" data-next>下一頁</button>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  import {
    ensureAdmin,
    adminFetch,
    localTime,
    articleLink
  } from '../lib/admin';

  type Message = {
    id: number;
    slug: string;
    comment_id: number;
    type: 'comment' | 'reply';
    name: string;
    message: string;
    created_at: string;
    is_owner?: number;
  };

  const root = document.querySelector<HTMLElement>('#admin-comments')!;

  const titles: Record<string, string> = JSON.parse(
    root.dataset.titles || '{}'
  );

  const list = root.querySelector<HTMLElement>('[data-items]')!;
  const status = root.querySelector<HTMLElement>('[data-status]')!;
  const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
  const next = root.querySelector<HTMLButtonElement>('[data-next]')!;

  const pendingList = root.querySelector<HTMLElement>(
    '[data-pending-items]'
  )!;
  const pendingStatus = root.querySelector<HTMLElement>(
    '[data-pending-status]'
  )!;
  const pendingCount = root.querySelector<HTMLElement>(
    '[data-pending-count]'
  )!;
  const pendingRefresh = root.querySelector<HTMLButtonElement>(
    '[data-pending-refresh]'
  )!;
  const pendingMore = root.querySelector<HTMLButtonElement>(
    '[data-pending-more]'
  )!;

  let offset = 0;
  let busy = false;
  let pendingOffset = 0;
  let pendingBusy = false;

  // 未回覆區與全部留言共用卡片、回覆與修改功能。
  function createCard(item: Message) {
    const card = document.createElement('section');
    card.className = 'admin-card';

    const meta = document.createElement('p');
    meta.className = 'admin-note';
    meta.textContent =
      `${item.is_owner ? '[Henry]' : item.name} · ${localTime(item.created_at)} · ${item.type === 'reply' ? '回覆' : '留言'}`;

    const article = document.createElement('a');
    article.href = articleLink(item.slug) + '#comments';
    article.textContent = titles[item.slug] || item.slug;

    const message = document.createElement('p');
    message.className = 'admin-message';
    message.textContent = item.message;

    const actions = document.createElement('div');
    actions.className = 'admin-actions';

    const reply = document.createElement('button');
    reply.type = 'button';
    reply.textContent = '回覆';
    reply.onclick = () => editor(false);

    actions.append(reply);
    card.append(meta, article, message, actions);

    if (item.is_owner) {
      const edit = document.createElement('button');
      edit.type = 'button';
      edit.textContent = '修改';
      edit.onclick = () => editor(true);
      actions.append(edit);
    }

    function editor(edit: boolean) {
      if (card.querySelector('form')) return;

      const form = document.createElement('form');
      form.className = 'admin-message-editor';

      const text = document.createElement('textarea');
      text.rows = 4;
      text.maxLength = 1000;
      text.required = true;
      text.setAttribute(
        'aria-label',
        edit ? '修改自己的留言' : `回覆 ${item.name}`
      );

      if (edit) text.value = message.textContent || '';

      const controls = document.createElement('div');
      controls.className = 'admin-actions';

      const submit = document.createElement('button');
      submit.type = 'submit';
      submit.textContent = edit ? '儲存修改' : '送出回覆';

      const cancel = document.createElement('button');
      cancel.type = 'button';
      cancel.textContent = '取消';
      cancel.onclick = () => form.remove();

      const feedback = document.createElement('p');
      feedback.setAttribute('role', 'status');

      controls.append(submit, cancel);
      form.append(text, controls, feedback);
      card.append(form);
      text.focus();

      form.onsubmit = async event => {
        event.preventDefault();

        const value = text.value.trim();
        if (!value || submit.disabled) return;

        submit.disabled = true;
        cancel.disabled = true;
        feedback.textContent = '送出中……';

        try {
          const body = edit
            ? {
                id: item.id,
                action: item.type === 'reply' ? 'thread-edit' : 'edit',
                message: value
              }
            : {
                comment_id: item.comment_id,
                target_type: item.type,
                target_id: item.id,
                message: value
              };

          await adminFetch(
            `/api/comments/${encodeURIComponent(item.slug)}`,
            {
              method: edit ? 'PATCH' : 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(body)
            }
          );

          form.remove();

          // 回覆成功後，同步更新未回覆區與全部留言。
          await Promise.all([loadPending(true), load()]);
        } catch (error) {
          feedback.textContent = error instanceof Error
            ? error.message
            : '送出失敗';
        } finally {
          submit.disabled = false;
          cancel.disabled = false;
        }
      };
    }

    return card;
  }

  // 未回覆留言使用獨立的載入更多功能。
  async function loadPending(reset = true) {
    if (pendingBusy) return;

    pendingBusy = true;
    pendingRefresh.disabled = true;
    pendingMore.disabled = true;
    pendingStatus.textContent = '載入中……';

    const requestedOffset = reset ? 0 : pendingOffset;

    try {
      const data = await adminFetch(
        `/api/admin-pending-comments?offset=${requestedOffset}`
      ) as {
        items: Message[];
        total: number;
        more: boolean;
      };

      if (reset) pendingList.replaceChildren();

      for (const item of data.items) {
        pendingList.append(createCard(item));
      }

      pendingOffset = requestedOffset + data.items.length;
      pendingCount.textContent = data.total ? `${data.total} 則` : '';
      pendingMore.hidden = !data.more;

      pendingStatus.textContent = pendingList.childElementCount
        ? ''
        : '沒有未回覆留言';
    } catch (error) {
      pendingStatus.textContent = error instanceof Error
        ? error.message
        : '無法讀取未回覆留言';
    } finally {
      pendingBusy = false;
      pendingRefresh.disabled = false;
      pendingMore.disabled = false;
    }
  }

  // 全部留言保留原本的排序與每頁 50 筆分頁。
  async function load() {
    if (busy) return;

    busy = true;
    prev.disabled = true;
    next.disabled = true;
    status.textContent = '載入中……';

    try {
      const data = await adminFetch(
        `/api/admin-comments?offset=${offset}`
      ) as {
        items: Message[];
        more: boolean;
      };

      list.replaceChildren();

      for (const item of data.items) {
        list.append(createCard(item));
      }

      status.textContent = data.items.length
        ? ''
        : '目前沒有留言。';

      prev.disabled = offset === 0;
      next.disabled = !data.more;

      root.querySelector<HTMLElement>('[data-page]')!.textContent =
        `第 ${Math.floor(offset / 50) + 1} 頁`;
    } catch (error) {
      status.textContent = error instanceof Error
        ? error.message
        : '載入失敗';
    } finally {
      busy = false;
    }
  }

  pendingRefresh.onclick = () => {
    void loadPending(true);
  };

  pendingMore.onclick = () => {
    void loadPending(false);
  };

  prev.onclick = () => {
    if (busy) return;
    offset = Math.max(0, offset - 50);
    void load();
  };

  next.onclick = () => {
    if (busy) return;
    offset += 50;
    void load();
  };

  if (await ensureAdmin()) {
    void loadPending();
    void load();
  }
</script>

<style is:global>
  #admin-comments .pending-comments {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border, #666);
  }

  #admin-comments .pending-heading-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: .75rem;
  }

  #admin-comments .pending-heading-row h2 {
    margin: 0;
  }

  #admin-comments [data-pending-count] {
    margin-left: .5rem;
    font-size: .85rem;
    font-weight: normal;
    opacity: .7;
  }

  #admin-comments [data-pending-more] {
    margin-top: 1rem;
  }

  #admin-comments [data-pending-more][hidden] {
    display: none;
  }

  #admin-comments .admin-message {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  #admin-comments .admin-message-editor {
    margin-top: 1rem;
  }

  #admin-comments .admin-message-editor textarea {
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin-bottom: .75rem;
    padding: .65rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--border, #666);
    border-radius: 6px;
  }
</style>