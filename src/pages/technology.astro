---
import { getCollection } from 'astro:content';
import CategoryPage from '../components/CategoryPage.astro';
import { visibleArticles } from '../lib/articles';
const articles = visibleArticles(await getCollection('articles')).filter((a) => a.data.category === '科技');
---
<CategoryPage title="科技" description="AI、半導體、產業與技術世界的結構性觀察。" articles={articles} />
