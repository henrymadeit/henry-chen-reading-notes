---
import { getCollection } from 'astro:content';
import CategoryPage from '../components/CategoryPage.astro';
import { visibleArticles } from '../lib/articles';
const articles = visibleArticles(await getCollection('articles')).filter((a) => a.data.category === '旅遊隨筆');
---
<CategoryPage title="旅遊隨筆" description="遠的或近的，風景與人事、過去以及當下片刻。" articles={articles} />
