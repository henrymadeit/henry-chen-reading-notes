---
import { getCollection } from 'astro:content';
import CategoryPage from '../components/CategoryPage.astro';
import { visibleArticles } from '../lib/articles';
const articles = visibleArticles(await getCollection('articles')).filter((a) => a.data.category === '行旅與隨想');
---
<CategoryPage title="行旅與隨想" description="遠的或近的，風景或人事，過去與當下。" articles={articles} />
