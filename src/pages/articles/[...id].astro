---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import LikeButton from '../../components/LikeButton.astro';
import Comments from '../../components/Comments.astro';
import ReaderTracking from '../../components/ReaderTracking.astro';
import { relatedArticles, visibleArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const all = visibleArticles(await getCollection('articles'));
  return all.map((article) => ({
    params: { id: article.id },
    props: { article, all }
  }));
}

const { article, all } = Astro.props;
const { Content } = await render(article);
const related = relatedArticles(article, all);
---

<ArticleLayout article={article} related={related}>
  <ReaderTracking slug={article.id} />
  <Content />
  <LikeButton slug={article.id} />
  <Comments slug={article.id} />
</ArticleLayout>

<script>
  function adjustPortraitImages() {
    const images = document.querySelectorAll<HTMLImageElement>(
      '.prose img'
    );

    images.forEach((img) => {
      function adjust() {
        if (img.naturalHeight > img.naturalWidth) {
          img.classList.add('portrait');
        } else {
          img.classList.remove('portrait');
        }
      }

      if (img.complete && img.naturalWidth > 0) {
        adjust();
      } else {
        img.addEventListener('load', adjust, { once: true });
      }
    });
  }

  document.addEventListener('astro:page-load', adjustPortraitImages);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', adjustPortraitImages);
  } else {
    adjustPortraitImages();
  }
</script>
