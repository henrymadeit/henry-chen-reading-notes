---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import LikeButton from '../../components/LikeButton.astro';
import Comments from '../../components/Comments.astro';
import ReaderTracking from '../../components/ReaderTracking.astro';
import { relatedArticles, visibleArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const all = visibleArticles(await getCollection('articles'));

  return all.map((article) => ({
    params: { id: article.id },
    props: { article, all }
  }));
}

const { article, all } = Astro.props;
const { Content } = await render(article);

// 依文章開頭指定的代碼尋找延伸閱讀
const extendedIds: string[] = article.data.extendedReading ?? [];

const extendedArticles = extendedIds
  .map((id) => all.find((item) => item.id === id))
  .filter((item) => item !== undefined);

// 從所有相關候選文章中排除延伸閱讀，再選前四篇
const related = relatedArticles(article, all, all.length)
  .filter((item) => !extendedIds.includes(item.id))
  .slice(0, 4);
---

<ArticleLayout article={article} related={related}>
  <ReaderTracking slug={article.id} />

  <Content />

  {extendedArticles.length > 0 && (
    <p>
      延伸閱讀：
      {extendedArticles.map((item, index) => (
        <>
          {index > 0 && '、'}
          <a href={`/articles/${item.id}/`}>〈{item.data.title}〉</a>
        </>
      ))}
    </p>
  )}

  <LikeButton slug={article.id} />
  <Comments slug={article.id} />
</ArticleLayout>

<script>
  function adjustImageSizes() {
    const images = document.querySelectorAll<HTMLImageElement>(
      '.prose img'
    );

    images.forEach((img) => {
      function adjust() {
        if (!img.naturalWidth || !img.naturalHeight) return;

        const r = img.naturalHeight / img.naturalWidth;

        // 60% 以下不縮小；100% 以上縮小至 62.5%
        const t = Math.max(0, Math.min(1, (r - 0.6) / 0.4));
        const scale = 1 - 0.375 * t;

        img.style.setProperty('--image-scale', String(scale));
        img.classList.add('auto-sized');
        img.classList.remove('portrait');
      }

      if (img.complete && img.naturalWidth > 0) {
        adjust();
      } else {
        img.addEventListener('load', adjust, { once: true });
      }
    });
  }

  document.addEventListener('astro:page-load', adjustImageSizes);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', adjustImageSizes);
  } else {
    adjustImageSizes();
  }
</script>