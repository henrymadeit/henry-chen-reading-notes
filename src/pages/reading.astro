---
import { getCollection } from 'astro:content';
import CategoryPage from '../components/CategoryPage.astro';
import { visibleArticles } from '../lib/articles';
const articles = visibleArticles(await getCollection('articles')).filter((a) => a.data.category === '閱讀隨筆');
---
<CategoryPage
  title="閱讀隨筆"
  description="閱讀的樂趣與意外的發現"
  articles={articles}
  heroImage="/images/headers/breakfast-harare.jpg"
  heroCaption="哈拉瑞的梅克爾斯凱悅飯店餐廳，辛巴威 - Aug 2026"
/>
