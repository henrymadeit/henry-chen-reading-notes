---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { visibleArticles, getYear } from '../../lib/articles';
export async function getStaticPaths() {
  const articles = visibleArticles(await getCollection('articles'));
  const years = [...new Set(articles.map(getYear))];
  return years.map((year) => ({ params: { year }, props: { year, articles: articles.filter((a) => getYear(a) === year) } }));
}
const { year, articles } = Astro.props;
---
<BaseLayout title={`${year} 年｜Henry Chen 的隨筆`}><header class="page-header wrap"><p class="eyebrow">Year</p><h1>{year}</h1><p>{articles.length} 篇文章</p></header><section class="wrap section"><div class="card-grid">{articles.map((a)=><ArticleCard article={a}/>)}</div></section></BaseLayout>
