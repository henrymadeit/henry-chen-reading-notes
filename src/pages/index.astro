---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { visibleArticles, categories, categoryPaths } from '../lib/articles';
const articles = visibleArticles(await getCollection('articles'));
const featured = articles.filter((a) => a.data.featured).slice(0, 4);
const pinned = articles.filter((a) => a.data.pinned).slice(0, 2);
const latest = articles.slice(0, 6);
const categoryDescriptions = {
  '閱讀隨筆': '閱讀的樂趣與意外的發現',
  '歷史與文明': '從海洋、土地與宗教，理解文明的選擇',
  '行旅與隨想': '遠的或近的，風景或人事，過去與當下',
  '台灣與世界': '從台灣出發，探索世界',
  // '廈門大稻埕陳氏': '一個家族往返廈門、上海與大稻埕的百年記憶。',
};
//在下方加上宣傳字語，不加就在'與'間空白
const promotion = '新增 台灣與世界 <由余杰的「養共為患」一書談起>';
const promotion2 = '新增 行旅與隨想 <納米比亞之旅>';


---
<BaseLayout>
  <section class="hero wrap home-hero">
    <p class="eyebrow">閱讀，旅行，聯想。</p>
    <h1>Henry Chen 的隨筆</h1>
    <p class="hero-copy">閱讀讓我看見世界，旅行讓我體會世界，寫作助我整理思緒。</p>
    <p class="hero-message">歡迎交流: henryreads.pages@gmail.com</p>
    {promotion && (
      <p class="hero-promotion">
      {promotion}<br />
      {promotion2}
      </p>
    )}
    <p class="hero-caption">丘比河，波茲瓦納 - Aug 2026</p>
  </section>

    {pinned.length > 0 && (
      <section class="wrap latest-section">
      <h2 class="latest-heading">最新文章</h2>
        {pinned.map((article) => (
          <div class="latest-item">
            <ArticleCard article={article} showLikes={true} wideCounts={true} />
          </div>
        ))}
      </section>
    )}


  {featured.length > 0 && (
    <section class="wrap section">
      <div class="section-heading">
        <h2>精選文章</h2>
      </div>

      <div class="card-grid featured-grid">
        {featured.map((article) => <ArticleCard article={article} showLikes={true} />)}
      </div>
    </section>
  )}
  
  <section class="wrap overview-section">
  <h2 class="overview-heading">分類總覽</h2>
  <div class="topic-grid" aria-label="主題">
    {categories.map((category) => <a class="topic-card" href={categoryPaths[category]}><h2>{category}</h2><p>{categoryDescriptions[category]}</p></a>)}
    </div>
  </section>

</BaseLayout>

<style>
  .hero-promotion {
    text-align: left;
    width: fit-content;
    margin-left: 3%;
    font-size: 0.85rem;
    color: #e6d518;
    font-weight: 750;
    margin-top: 5.5rem;
  }

  .home-hero {
    position: relative;
  }

  .hero-caption {
    position: absolute;
    right: 0.8rem;
    bottom: 0.5rem;
    margin: 0;
    font-size: 0.8rem;
    font-weight: 900;
    color: rgb(255, 255, 255);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.9);
  }

</style>

