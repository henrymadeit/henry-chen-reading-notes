---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/admin.css';
---

<BaseLayout title="管理｜Henry Chen 的隨筆" noindex={true}>
  <article class="article-shell admin-shell" data-pagefind-ignore>
    <header class="article-header">
      <p class="eyebrow">Admin</p>
      <h1>網站管理</h1>
    </header>

    <div class="prose">
      <p data-login-status>正在確認登入狀態……</p>
      <div class="admin-menu" data-admin-menu hidden>
        <a href="/admin-comments"><strong>回覆留言</strong><p>查看與回覆讀者的留言</p></a>
        <a href="/dashboard"><strong>Dashboard</strong><p>讀者列表與閱讀足跡</p></a>
      </div>
      <button type="button" data-logout hidden>登出</button>
      <form class="admin-login" hidden>
        <label>
          管理密碼
          <input
            type="password"
            name="password"
            autocomplete="current-password"
            required
          />
        </label>

        <button type="submit">登入</button>
      </form>
    </div>
  </article>
</BaseLayout>
  <script>
  import {adminFetch} from '../lib/admin';
  const form = document.querySelector<HTMLFormElement>('.admin-login');
  const menu = document.querySelector<HTMLElement>('[data-admin-menu]');
  const logout = document.querySelector<HTMLButtonElement>('[data-logout]');
  const status = document.querySelector<HTMLElement>('[data-login-status]');
  function showMenu() {
    if (form) form.hidden = true;
    if (menu) menu.hidden = false;
    if (logout) logout.hidden = false;
    if (status) status.textContent = '';
  }
  try {
    const data = await adminFetch('/api/admin-status');
    if (data.admin) showMenu();
    else { if (form) form.hidden = false; if (status) status.textContent = ''; }
  } catch { if (form) form.hidden = false; if (status) status.textContent = '請登入'; }
  logout?.addEventListener('click', async () => {
    try { await adminFetch('/admin-logout', {method:'POST'}); location.reload(); }
    catch { alert('登出失敗，請再試一次。'); }
  });

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();

    const input = form.querySelector<HTMLInputElement>('input[name="password"]');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');

    if (!input || !input.value) return;

    if (button) button.disabled = true;

    try {
      const response = await fetch('/api/admin-login', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          password: input.value
        })
      });

      const result = await response.json() as {
        success?: boolean;
        error?: string;
      };

      if (!response.ok || !result.success) {
        alert(result.error || '登入失敗');
        return;
      }

      showMenu();
    } catch {
      alert('登入失敗');
    } finally {
      input.value = '';
      if (button) button.disabled = false;
    }
  });
  </script>
<style>
  .admin-login {
    display: grid;
    gap: 1rem;
    max-width: 360px;
  }

  .admin-login label {
    display: grid;
    gap: 0.4rem;
  }

  .admin-login input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.8rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--border, #aaa);
    border-radius: 6px;
  }

  .admin-login button {
    justify-self: start;
    padding: 0.55rem 1rem;
    font: inherit;
    cursor: pointer;
  }
</style>