---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { visibleArticles } from '../../lib/articles';
export async function getStaticPaths() {
  const articles = visibleArticles(await getCollection('articles'));
  const authors = [...new Set(articles.map((a) => a.data.bookAuthor).filter(Boolean))] as string[];
  return authors.map((author) => ({ params: { author }, props: { author, articles: articles.filter((a) => a.data.bookAuthor === author) } }));
}
const { author, articles } = Astro.props;
---
<BaseLayout title={`${author}｜作者索引｜Henry Chen 的隨筆`}><header class="page-header wrap"><p class="eyebrow">Author</p><h1>{author}</h1><p>{articles.length} 篇閱讀隨筆</p></header><section class="wrap section"><div class="card-grid">{articles.map((a)=><ArticleCard article={a}/>)}</div></section></BaseLayout>
