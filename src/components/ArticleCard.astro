---
import type { Article } from '../lib/articles';
import { dateFormatter } from '../lib/articles';
const { article, compact = false, showLikes = false, wideCounts = false } = Astro.props as { article: Article; compact?: boolean; showLikes?: boolean; wideCounts?: boolean };
---
<article class:list={['article-card', { compact, 'wide-counts': wideCounts }]}>
  <p class="eyebrow">
  {article.data.category} · {dateFormatter.format(article.data.published)}
</p>
  <h2><a href={`/articles/${article.id}/`}>{article.data.title}</a></h2>
  {!compact && <p>{article.data.description}</p>}
<div class="tag-row">
  {article.data.tags.slice(0, compact ? 2 : 4).map((tag) => (
    <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>
  ))}
</div>

  {showLikes && (
  <div class="card-counts">
    <span data-card-like-count="" data-slug={article.id}>♥ 0</span>
    <span data-card-comment-count="" data-slug={article.id}>💬 0</span>
  </div>
  )}

</article>

<style>
  .article-card {
    position: relative;
  }

  .tag-row {
    padding-right: 3.5rem;
  }

  .card-counts {
  position: absolute;
  right: 2rem;
  bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 0.8rem;
  font-size: 1rem;
  font-weight: 600;
  white-space: nowrap;
  }

[data-card-like-count] {
  color: #c76b7a;
}

[data-card-comment-count] {
  color: inherit;
  opacity: 0.7;
}
</style>

<script>
  const likeCounts = document.querySelectorAll("[data-card-like-count]");
  const commentCounts = document.querySelectorAll("[data-card-comment-count]");

  likeCounts.forEach(async (element) => {
    if (!(element instanceof HTMLElement)) return;

    const slug = element.dataset.slug;
    if (!slug) return;

    try {
      const response = await fetch(
        `/api/likes/${encodeURIComponent(slug)}`
      );

      if (!response.ok) return;

      const data = await response.json();
      element.textContent = `♥ ${data.likes ?? 0}`;
    } catch (error) {
      console.error("Unable to load card likes:", error);
    }
  });
  commentCounts.forEach(async (element) => {
  if (!(element instanceof HTMLElement)) return;

  const slug = element.dataset.slug;
  if (!slug) return;

  try {
    const response = await fetch(
      `/api/comments/${encodeURIComponent(slug)}`
    );

    if (!response.ok) return;

    const comments = await response.json();

    if (!Array.isArray(comments)) return;

    element.textContent = `💬 ${comments.length}`;
  } catch (error) {
    console.error("Unable to load card comments:", error);
  }
  });
</script>
