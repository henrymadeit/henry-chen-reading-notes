---
const path = Astro.url.pathname;
const links = [
  ['閱讀隨筆', '/reading/'],
  ['歷史與文明', '/history/'],
  ['行旅與隨想', '/travel/'],
  ['台灣與世界', '/taiwan-world/']
  // ['台灣與世界', '/chen-family/']
];
---

<header class="site-header">
  <div class="header-inner">
    <a class="brand" href="/">Henry Chen 的隨筆</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">選單</button>
    <nav id="site-nav" aria-label="主要導覽">
      {links.map(([label, href]) => <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>{label}</a>)}
      <a href="/search/" aria-current={path.startsWith('/search') ? 'page' : undefined}>搜尋</a>
      <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>關於</a>
      <a href="#" id="admin-logout" style="display:none;">登出</a>
    </nav>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="切換深色模式" title="切換深色模式">◐</button>
  </div>
</header>
<script is:inline>
  const bindHeader = () => {
    const menu = document.querySelector('.menu-toggle');
    const nav = document.querySelector('#site-nav');
    menu?.addEventListener('click', () => {
      const open = menu.getAttribute('aria-expanded') === 'true';
      menu.setAttribute('aria-expanded', String(!open));
      nav?.classList.toggle('open', !open);
    });
    document.querySelector('#theme-toggle')?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  const logoutLink = document.querySelector('#admin-logout');

if (logoutLink) {
  fetch('/api/admin-status')
    .then(response => response.json())
    .then(result => {
      if (!result.admin) return;

      logoutLink.style.display = '';

      logoutLink.addEventListener('click', async (event) => {
        event.preventDefault();

        alert('準備登出');

        try {
          const response = await fetch('/admin-logout', {
            method: 'POST'
          });

          if (response.ok) {
            window.location.href = '/';
          }
        } catch (error) {
          alert(`logout error: ${error}`);
        }
      });
    })
    .catch(() => {});
}
  };

  bindHeader();
</script>
