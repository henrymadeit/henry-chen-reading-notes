---
const {slug} = Astro.props;
---
<span data-reader-article={slug} hidden></span>
<script>
  const marker = document.querySelector<HTMLElement>('[data-reader-article]');
  let sent = false;
  function track() {
    if (sent || document.visibilityState !== 'visible' || !marker?.dataset.readerArticle) return;
    sent = true;
    void fetch('/api/reader-events', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body:JSON.stringify({slug:marker.dataset.readerArticle}), keepalive:true
    }).catch(() => {});
  }
  track();
  document.addEventListener('visibilitychange', track);
</script>
