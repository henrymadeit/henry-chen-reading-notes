---
import type { Article } from '../lib/articles';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
const { title, description, articles, heroImage, heroCaption } = Astro.props as {
  title: string;
  description: string;
  articles: Article[];
  heroImage?: string;
  heroCaption?: string;
};
---
<BaseLayout title={`${title}｜Henry Chen 的隨筆`} description={description}>
  <header
   class:list={['page-header', 'wrap', { 'page-header-hero': heroImage }]}
    style={heroImage ? `--hero-image: url('${heroImage}')` : undefined}
  >
  <h1>{title}</h1>
  <p>{description}</p>
  {heroCaption && <p class="section-hero-caption">{heroCaption}</p>}
</header>
  <section class="wrap section"><div class="card-grid">{articles.map((article) => <ArticleCard article={article} showLikes />)}</div></section>
</BaseLayout>
