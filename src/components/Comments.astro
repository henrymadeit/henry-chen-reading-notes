---
const { slug } = Astro.props;
---
<section id="comments" class="comments" data-comments data-slug={slug}>
  <h2 data-reader-greeting>
    留下您的稱呼，讓我知道您來過
    - Let me know you were here -
  </h2>

  <button
    type="button"
    class="reader-change-name"
    data-reader-change-name
    hidden
  >更改稱呼</button>

  <form class="comment-form" data-reader-name-form>
    <input
      type="text"
      name="name"
      aria-label="您希望如何被稱呼？"
      placeholder="暱稱也好，不一定要留言喲 - Leave your name here, even no message yet -"
      maxlength="40"
      required
    />

    <div class="comment-submit-row">
      <span
        class="comment-status"
        data-reader-name-status
        role="status"
        aria-live="polite"
      ></span>
      <button type="submit">Save</button>
    </div>
  </form>

  <h2>歡迎留言 - Leave your message here -</h2>

  <form class="comment-form" data-comment-form>
    <textarea
      name="message"
      aria-label="歡迎留言"
      placeholder="請在這裡告訴我你的想法 - Tell me what you think -"
      rows="4"
      maxlength="1000"
      required
    ></textarea>

    <div class="comment-submit-row">
      <span class="comment-status" data-comment-status></span>
      <button type="submit">Send</button>
    </div>
  </form>

  <div class="comment-list" data-comment-list>
    <p class="comment-loading">載入留言中……</p>
  </div>
</section>

<script>
  type Reply = {
    id: number;
    comment_id: number;
    target_type: 'comment' | 'reply';
    target_id: number;
    name: string;
    message: string;
    created_at: string;
    likes: number;
    is_owner: number;
  };

  type ThreadComment = {
    id: number;
    name: string;
    message: string;
    created_at: string;
    edited_at: string | null;
    is_owner: number;
    likes: number;
    replies: Reply[];
  };

  type Target = {
    type: 'comment' | 'reply';
    id: number;
    name: string;
  };

  const EDIT_WINDOW_MS = 60 * 60 * 1000;

  for (const section of document.querySelectorAll<HTMLElement>('[data-comments]')) {
    const slug = section.dataset.slug;
    const list = section.querySelector<HTMLElement>('[data-comment-list]');
    const form = section.querySelector<HTMLFormElement>('[data-comment-form]');
    const status = section.querySelector<HTMLElement>('[data-comment-status]');

    if (!slug || !list || !form || !status) continue;

    const apiUrl = `/api/comments/${encodeURIComponent(slug)}`;
    const savedNameKey = 'comment-display-name';

    let isAdmin = false;
    let activeForm: HTMLElement | null = null;

    const nameForm =
      section.querySelector<HTMLFormElement>('[data-reader-name-form]')!;

    const nameStatus =
      section.querySelector<HTMLElement>('[data-reader-name-status]')!;

    const mainName =
      nameForm.elements.namedItem('name') as HTMLInputElement;

    const greeting =
      section.querySelector<HTMLElement>('[data-reader-greeting]')!;

    const changeName =
      section.querySelector<HTMLButtonElement>('[data-reader-change-name]')!;

    function showNamedVisitor(name: string) {
      greeting.textContent = '謝謝 ' + name + ' 您的來訪';
      nameForm.hidden = true;
      changeName.hidden = false;
    }

    mainName.value = localStorage.getItem(savedNameKey) ?? '';

    if (mainName.value.trim()) {
      showNamedVisitor(mainName.value.trim());
    }

    changeName.addEventListener('click', () => {
      greeting.textContent = '您希望如何被稱呼？';
      nameForm.hidden = false;
      changeName.hidden = true;
      nameStatus.textContent = '';
      mainName.focus();
    });

    nameForm.addEventListener('submit', async event => {
      event.preventDefault();

      const name = mainName.value.trim();
      if (!name || isAdmin) return;

      const button =
        nameForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;

      button.disabled = true;
      nameStatus.textContent = '儲存中……';

      try {
        const response = await fetch('/api/reader-name', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({name})
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.error || '名字儲存失敗，請再試一次。'
          );
        }

        localStorage.setItem(savedNameKey, name);
        mainName.value = name;
        nameStatus.textContent = '';
        showNamedVisitor(name);
      } catch (error) {
        nameStatus.textContent =
          error instanceof Error
            ? error.message
            : '名字儲存失敗，請再試一次。';
      } finally {
        button.disabled = false;
      }
    });

    function parseDatabaseDate(value: string): Date {
      const normalized =
        value.trim().replace(' ', 'T').replace(/Z$/i, '');

      return new Date(`${normalized}Z`);
    }

    function formatDate(value: string) {
      return new Intl.DateTimeFormat('zh-TW', {
        year: 'numeric',
        month: 'numeric',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'Asia/Taipei'
      }).format(parseDatabaseDate(value));
    }

    function makeButton(
      label: string,
      className: string,
      click: () => void
    ) {
      const button = document.createElement('button');

      button.type = 'button';
      button.className = className;
      button.textContent = label;
      button.addEventListener('click', click);

      return button;
    }

    /* 留言編輯 */

    function editTokenKey(id: number) {
      return `comment-edit-token:${id}`;
    }

    function remainingEditTime(comment: ThreadComment) {
      if (isAdmin) return Infinity;

      const created =
        parseDatabaseDate(comment.created_at).getTime();

      return EDIT_WINDOW_MS - (Date.now() - created);
    }

    function canEditComment(comment: ThreadComment) {
      if (comment.is_owner === 1) return isAdmin;
      if (isAdmin) return false;

      const token =
        localStorage.getItem(editTokenKey(comment.id));

      if (!token) return false;

      return remainingEditTime(comment) > 0;
    }

    function addEditedMark(
      element: HTMLElement,
      editedAt: string | null
    ) {
      if (!editedAt) return;

      const edited = document.createElement('span');
      edited.className = 'comment-edited';
      edited.textContent = '已編輯';

      element.appendChild(edited);
    }

    function openEditCommentForm(
      comment: ThreadComment,
      article: HTMLElement
    ) {
      activeForm?.remove();

      const editForm = document.createElement('form');
      editForm.className = 'comment-reply-form comment-edit-form';
      activeForm = editForm;

      const heading = document.createElement('div');
      heading.className = 'reply-form-heading';
      heading.textContent = '修改留言';

      const cancel = makeButton(
        '取消',
        'comment-cancel',
        () => {
          editForm.remove();
          activeForm = null;
        }
      );

      heading.appendChild(cancel);
      editForm.appendChild(heading);

      const textarea = document.createElement('textarea');
      textarea.value = comment.message;
      textarea.rows = 4;
      textarea.maxLength = 1000;
      textarea.required = true;

      editForm.appendChild(textarea);

      const row = document.createElement('div');
      row.className = 'comment-submit-row';

      const feedback = document.createElement('span');
      feedback.className = 'comment-status';

      const save = document.createElement('button');
      save.type = 'submit';
      save.textContent = '儲存';

      row.append(feedback, save);
      editForm.appendChild(row);

      editForm.addEventListener('submit', async event => {
        event.preventDefault();

        const message = textarea.value.trim();
        if (!message) return;

        save.disabled = true;
        feedback.textContent = '儲存中⋯⋯';

        try {
          const editToken =
            localStorage.getItem(editTokenKey(comment.id)) ?? '';

          const response = await fetch(apiUrl, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: comment.id,
              action: 'edit',
              message,
              editToken
            })
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || '修改失敗');
          }

          activeForm = null;
          await loadComments();
        } catch (error) {
          feedback.textContent =
            error instanceof Error ? error.message : '修改失敗';

          save.disabled = false;
        }
      });

      const actions = article.querySelector('.comment-actions');

      if (actions) {
        actions.after(editForm);
      } else {
        article.appendChild(editForm);
      }

      textarea.focus();

      editForm.scrollIntoView({
        block: 'nearest',
        behavior: 'smooth'
      });
    }

    function makeCommentEditControls(
      comment: ThreadComment,
      article: HTMLElement
    ) {
      const wrapper = document.createElement('span');
      wrapper.className = 'comment-edit-controls';

      const button = makeButton(
        '編輯',
        'comment-edit-button',
        () => openEditCommentForm(comment, article)
      );

      wrapper.appendChild(button);

      /*
       * Henry 自己的留言永久可編輯。
       * 訪客自己的留言於 60 分鐘後移除編輯入口。
       */
      if (!(comment.is_owner === 1 && isAdmin)) {
        const created = parseDatabaseDate(comment.created_at);

        const deadline = new Date(
          created.getTime() + EDIT_WINDOW_MS
        );

        const deadlineText = document.createElement('span');
        deadlineText.className = 'comment-edit-deadline';

        deadlineText.textContent =
          `(${new Intl.DateTimeFormat('zh-TW', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
            timeZone: 'Asia/Taipei'
          }).format(deadline)} 前可編輯)`;

        wrapper.appendChild(deadlineText);

        const remaining = remainingEditTime(comment);

        if (remaining > 0) {
          window.setTimeout(() => {
            wrapper.remove();

            if (
              activeForm?.classList.contains('comment-edit-form')
            ) {
              activeForm.remove();
              activeForm = null;
            }
          }, remaining);
        }
      }

      return wrapper;
    }

    /* 愛心 */

    function likeButton(
      id: number,
      count: number,
      kind: 'comment' | 'reply'
    ) {
      const key =
        kind === 'comment'
          ? `comment-liked-${id}`
          : `thread-reply-liked:${id}`;

      let liked = localStorage.getItem(key) === '1';

      const button = makeButton(
        `${liked ? '♥' : '♡'} ${count}`,
        'comment-like',
        async () => {
          button.disabled = true;

          try {
            const action =
              kind === 'comment'
                ? liked
                  ? 'unlike'
                  : 'like'
                : liked
                  ? 'thread-unlike'
                  : 'thread-like';

            const response = await fetch(apiUrl, {
              method: 'PATCH',
              headers: {
                'Content-Type': 'application/json'
              },
              body: JSON.stringify({
                id,
                action
              })
            });

            const result = await response.json();
            const value = result.likes;

            if (!response.ok || typeof value !== 'number') {
              throw new Error();
            }

            liked = !liked;

            if (liked) {
              localStorage.setItem(key, '1');
            } else {
              localStorage.removeItem(key);
            }

            button.classList.toggle('liked', liked);
            button.textContent = `${liked ? '♥' : '♡'} ${value}`;
          } catch {
            // 失敗時保留原本的愛心數。
          } finally {
            button.disabled = false;
          }
        }
      );

      button.classList.toggle('liked', liked);

      return button;
    }

    /* 回覆表單 */

    function openReplyForm(
      comment: ThreadComment,
      target: Target,
      thread: HTMLElement,
      after?: HTMLElement,
      depth = 0
    ) {
      activeForm?.remove();

      const replyForm = document.createElement('form');
      replyForm.className = 'comment-reply-form';
      replyForm.style.marginLeft = `${depth * 2}rem`;

      activeForm = replyForm;

      const heading = document.createElement('div');
      heading.className = 'reply-form-heading';
      heading.textContent = `回覆 ${target.name}`;

      const cancel = makeButton(
        '取消',
        'comment-cancel',
        () => {
          replyForm.remove();
          activeForm = null;
        }
      );

      heading.appendChild(cancel);
      replyForm.appendChild(heading);

      let nameInput: HTMLInputElement | null = null;

      if (isAdmin) {
        const owner = document.createElement('span');
        owner.textContent = '以 [Henry] 回覆';
        replyForm.appendChild(owner);
      } else {
        const label = document.createElement('label');
        label.textContent = '您希望如何被稱呼？';

        nameInput = document.createElement('input');
        nameInput.name = 'name';
        nameInput.maxLength = 40;
        nameInput.required = true;
        nameInput.value = localStorage.getItem(savedNameKey) ?? '';

        label.appendChild(nameInput);
        replyForm.appendChild(label);
      }

      const label = document.createElement('label');
      label.textContent = '回覆內容';

      const textarea = document.createElement('textarea');
      textarea.name = 'message';
      textarea.rows = 3;
      textarea.maxLength = 1000;
      textarea.required = true;

      label.appendChild(textarea);
      replyForm.appendChild(label);

      const row = document.createElement('div');
      row.className = 'comment-submit-row';

      const feedback = document.createElement('span');
      feedback.className = 'comment-status';

      const send = document.createElement('button');
      send.type = 'submit';
      send.textContent = '送出回覆';

      row.append(feedback, send);
      replyForm.appendChild(row);

      replyForm.addEventListener('submit', async event => {
        event.preventDefault();

        const name =
          isAdmin ? 'Henry' : nameInput?.value.trim();

        const message = textarea.value.trim();

        if (!name || !message) return;

        send.disabled = true;
        feedback.textContent = '送出中⋯⋯';

        try {
          const response = await fetch(apiUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              comment_id: comment.id,
              target_type: target.type,
              target_id: target.id,
              name,
              message
            })
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || '回覆失敗');
          }

          if (!isAdmin) {
            localStorage.setItem(savedNameKey, name);
          }

          activeForm = null;
          await loadComments();
        } catch (error) {
          feedback.textContent =
            error instanceof Error ? error.message : '回覆失敗';

          send.disabled = false;
        }
      });

      if (after) {
        after.after(replyForm);
      } else {
        thread.prepend(replyForm);
      }

      (
        nameInput && !nameInput.value
          ? nameInput
          : textarea
      ).focus();

      replyForm.scrollIntoView({
        block: 'nearest',
        behavior: 'smooth'
      });
    }

    function openThreadEditForm(
      entry: Reply,
      item: HTMLElement
    ) {
      activeForm?.remove();

      const edit = document.createElement('form');
      edit.className = 'comment-reply-form';

      activeForm = edit;

      const heading = document.createElement('div');
      heading.className = 'reply-form-heading';
      heading.textContent = '修改回覆';

      const cancel = makeButton(
        '取消',
        'comment-cancel',
        () => {
          edit.remove();
          activeForm = null;
        }
      );

      heading.appendChild(cancel);
      edit.appendChild(heading);

      const textarea = document.createElement('textarea');
      textarea.value = entry.message;
      textarea.maxLength = 1000;
      textarea.required = true;
      textarea.rows = 3;

      edit.appendChild(textarea);

      const row = document.createElement('div');
      row.className = 'comment-submit-row';

      const feedback = document.createElement('span');
      feedback.className = 'comment-status';

      const save = document.createElement('button');
      save.type = 'submit';
      save.textContent = '儲存';

      row.append(feedback, save);
      edit.appendChild(row);

      edit.addEventListener('submit', async event => {
        event.preventDefault();

        const message = textarea.value.trim();
        if (!message) return;

        save.disabled = true;
        feedback.textContent = '儲存中⋯⋯';

        try {
          const response = await fetch(apiUrl, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: entry.id,
              action: 'thread-edit',
              message
            })
          });

          const result = await response.json();

          if (!response.ok) {
            throw new Error(result.error || '修改失敗');
          }

          activeForm = null;
          await loadComments();
        } catch (error) {
          feedback.textContent =
            error instanceof Error ? error.message : '修改失敗';

          save.disabled = false;
        }
      });

      item.appendChild(edit);
      textarea.focus();
    }

    /* 回覆顯示 */

    function renderEntry(
      comment: ThreadComment,
      entry: Reply,
      thread: HTMLElement,
      depth: number
    ) {
      const target: Target = {
        type: 'reply',
        id: entry.id,
        name: entry.is_owner ? '[Henry]' : entry.name
      };

      const item = document.createElement('div');
      item.className = 'comment-thread-entry';
      item.style.marginLeft = `${(depth - 1) * 2}rem`;

      const header = document.createElement('div');
      header.className = 'comment-header';

      const name = document.createElement('strong');
      name.textContent = entry.is_owner ? '[Henry]' : entry.name;

      header.appendChild(name);

      const to = document.createElement('span');
      to.className = 'comment-to';

      if (entry.target_type === 'comment') {
        to.textContent = `→ ${comment.name}`;
      } else {
        const recipient =
          comment.replies.find(r => r.id === entry.target_id);

        to.textContent =
          `→ ${
            recipient
              ? recipient.is_owner
                ? '[Henry]'
                : recipient.name
              : '留言者'
          }`;
      }

      header.appendChild(to);

      const time = document.createElement('time');
      time.textContent = formatDate(entry.created_at);

      header.appendChild(time);

      const message = document.createElement('p');
      message.className = 'comment-message';
      message.textContent = entry.message;

      const actions = document.createElement('div');
      actions.className = 'comment-actions';

      actions.appendChild(
        likeButton(entry.id, entry.likes, 'reply')
      );

      actions.appendChild(
        makeButton(
          '回覆',
          'comment-reply-button',
          () => openReplyForm(
            comment,
            target,
            thread,
            item,
            depth
          )
        )
      );

      if (entry.is_owner && isAdmin) {
        actions.appendChild(
          makeButton(
            '編輯',
            'comment-edit-button',
            () => openThreadEditForm(entry, item)
          )
        );
      }

      item.append(header, message, actions);

      return item;
    }

    /* 回覆排序 */

    function orderThreadEntries(
      comment: ThreadComment
    ): Array<{
      reply: Reply;
      depth: number;
    }> {
      const entries: Array<{
        time: string;
        id: number;
        reply: Reply;
      }> = comment.replies.map(reply => ({
        time: reply.created_at,
        id: reply.id,
        reply
      }));

      entries.sort(
        (a, b) =>
          a.time.localeCompare(b.time) ||
          a.id - b.id
      );

      const replyIds =
        new Set(comment.replies.map(reply => reply.id));

      const children =
        new Map<string, typeof entries>();

      for (const entry of entries) {
        const reply = entry.reply;
        let parent = 'root';

        if (
          reply.target_type === 'reply' &&
          replyIds.has(reply.target_id)
        ) {
          parent = `reply:${reply.target_id}`;
        }

        const siblings = children.get(parent) ?? [];
        siblings.push(entry);
        children.set(parent, siblings);
      }

      const ordered: Array<{
        reply: Reply;
        depth: number;
      }> = [];

      const shown = new Set<string>();

      function showBranch(
        entry: (typeof entries)[number],
        depth: number
      ) {
        const key = `reply:${entry.id}`;

        if (shown.has(key)) return;

        shown.add(key);

        ordered.push({
          reply: entry.reply,
          depth
        });

        for (const child of children.get(key) ?? []) {
          showBranch(child, depth + 1);
        }
      }

      for (const entry of children.get('root') ?? []) {
        showBranch(entry, 1);
      }

      // 保留沒有找到上層留言的回覆。
      for (const entry of entries) {
        showBranch(entry, 1);
      }

      return ordered;
    }

    /* 載入留言 */

    async function loadComments() {
      try {
      const response = await fetch(apiUrl);

      if (!response.ok) {
        throw new Error();
      }

      const comments = (await response.json()) as ThreadComment[];

      list!.replaceChildren();

      // 複製「歡迎留言」標題，沿用相同字體與樣式
        const sourceHeading = section.querySelector(
        'h2:not([data-reader-greeting])'
      )!;

      const heading = sourceHeading.cloneNode(false) as HTMLElement;

      heading.textContent = comments.length > 0
      ? '現有留言'
      : '目前沒有留言';

      list!.appendChild(heading);

      if (comments.length === 0) {
         return;
      }

        for (const comment of comments) {
          const article = document.createElement('article');
          article.className = 'comment-item';

          const header = document.createElement('div');
          header.className = 'comment-header';

          const name = document.createElement('strong');
          name.textContent = comment.name;

          const time = document.createElement('time');
          time.textContent = formatDate(comment.created_at);

          header.append(name, time);

          const message = document.createElement('p');
          message.className = 'comment-message';

          const messageText = document.createElement('span');
          messageText.textContent = comment.message;

          message.appendChild(messageText);
          addEditedMark(message, comment.edited_at);

          const actions = document.createElement('div');
          actions.className = 'comment-actions';

          actions.appendChild(
            likeButton(comment.id, comment.likes, 'comment')
          );

          const thread = document.createElement('div');
          thread.className = 'comment-thread';

          actions.appendChild(
            makeButton(
              '回覆',
              'comment-reply-button',
              () => openReplyForm(
                comment,
                {
                  type: 'comment',
                  id: comment.id,
                  name: comment.name
                },
                thread
              )
            )
          );

          if (canEditComment(comment)) {
            actions.appendChild(
              makeCommentEditControls(comment, article)
            );
          }

          article.append(
            header,
            message,
            actions,
            thread
          );

          for (const entry of orderThreadEntries(comment)) {
            thread.appendChild(
              renderEntry(
                comment,
                entry.reply,
                thread,
                entry.depth
              )
            );
          }

          list!.appendChild(article);
        }
      } catch {
        list!.textContent = '留言載入失敗，請稍後再試。';
      }
    }

    /* 新留言 */

    form.addEventListener('submit', async event => {
      event.preventDefault();

      const button =
        form.querySelector<HTMLButtonElement>('button[type="submit"]');

      const data = new FormData(form);
      const name = mainName.value.trim();
      const message = String(data.get('message') ?? '').trim();

      if (!name) {
        status.textContent = '請先在上方填寫您希望使用的稱呼。';
        mainName.focus();
        return;
      }

      if (!message) return;

      const editToken = isAdmin ? '' : crypto.randomUUID();

      status.textContent = '送出中⋯⋯';

      if (button) {
        button.disabled = true;
      }

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            name,
            message,
            editToken
          })
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.error || '留言送出失敗');
        }

        if (result.id && !isAdmin) {
          localStorage.setItem(
            editTokenKey(Number(result.id)),
            editToken
          );
        }

        localStorage.setItem(savedNameKey, name);

        form.reset();
        mainName.value = name;

        if (!isAdmin) {
          showNamedVisitor(name);
        }

        status.textContent = '留言已送出。';

        await loadComments();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : '留言送出失敗';
      } finally {
        if (button) {
          button.disabled = false;
        }
      }
    });

    /* 確認站主登入狀態 */

    try {
      const response = await fetch('/api/admin-status');

      if (response.ok) {
        isAdmin = (await response.json()).admin === true;
      }

      if (isAdmin) {
        mainName.value = 'Henry';
        mainName.readOnly = true;

        showNamedVisitor('Henry');
        changeName.hidden = true;

        nameForm.querySelector<HTMLButtonElement>(
          'button[type="submit"]'
        )!.hidden = true;
      }
    } catch {
      isAdmin = false;
    }

    await loadComments();
  }
</script>

