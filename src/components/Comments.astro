---
const { slug } = Astro.props;
---

<section class="comments" data-comments data-slug={slug}>
  <div class="comment-list" data-comment-list>
  <p class="comment-loading">載入留言中……</p>
</div>

  <h2>歡迎留言</h2>
  <form class="comment-form" data-comment-form>
    <label>
      您希望如何被稱呼？
      <input
        type="text"
        name="name"
        maxlength="40"
        required
      />
    </label>

    <label>
      寫下您的留言
      <textarea
        name="message"
        rows="4"
        maxlength="1000"
        required
      ></textarea>
    </label>

    <div class="comment-submit-row">
      <span class="comment-status" data-comment-status></span>
      <button type="submit">送出留言</button>
    </div>
  </form>
</section>

<script>
  const sections = document.querySelectorAll<HTMLElement>('[data-comments]');

  for (const section of sections) {
    const slug = section.dataset.slug;
    const list = section.querySelector<HTMLElement>('[data-comment-list]');
    const form = section.querySelector<HTMLFormElement>('[data-comment-form]');
    const status = section.querySelector<HTMLElement>('[data-comment-status]');

    if (!slug || !list || !form || !status) continue;

    const apiUrl = `/api/comments/${encodeURIComponent(slug)}`;

    let isAdmin = false;
      async function checkAdmin() {
        try {
          const response = await fetch('/api/admin-status');
            if (!response.ok) return false;
          const result = await response.json() as {
          admin?: boolean;
          };
          return result.admin === true;
        } catch {
          return false;
          }
    }

    function formatDate(value: string) {
      const date = new Date(value.replace(' ', 'T') + 'Z');

      return new Intl.DateTimeFormat('zh-TW', {
        year: 'numeric',
        month: 'numeric',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit',
        timeZone: 'Asia/Taipei'
      }).format(date);
    }

async function loadComments() {
  try {
    const response = await fetch(apiUrl);

    if (!response.ok) throw new Error();

    const comments = await response.json() as Array<{
      id: number;
      name: string;
      message: string;
      created_at: string;
      likes: number;
      reply: string | null;
      reply_updated_at: string | null;
      reply_likes: number;
    }>;

    list.replaceChildren();

    if (comments.length === 0) {
      const empty = document.createElement('p');
      empty.className = 'comment-empty';
      empty.textContent = '還沒有留言。';
      list.appendChild(empty);
      return;
    }

    for (const comment of comments) {
      const article = document.createElement('article');
      article.className = 'comment-item';

      const header = document.createElement('div');
      header.className = 'comment-header';

      const name = document.createElement('strong');
      name.textContent = comment.name;

      const time = document.createElement('time');
      time.textContent = formatDate(comment.created_at);

      const message = document.createElement('p');
      message.textContent = comment.message;

      const likeKey = `comment-liked-${comment.id}`;
      let liked = localStorage.getItem(likeKey) === '1';

      const likeButton = document.createElement('button');
      likeButton.type = 'button';
      likeButton.className = 'comment-like';
      likeButton.textContent = `${liked ? '♥' : '♡'} ${comment.likes}`;

      if (liked) {
         likeButton.classList.add('liked');
       }

      likeButton.addEventListener('click', async () => {
        likeButton.disabled = true;

        try {
          const response = await fetch(apiUrl, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              id: comment.id,
              action: liked ? 'unlike' : 'like'
            })
          });

          if (!response.ok) throw new Error();

          const result = await response.json() as {
            likes: number;
          };

          liked = !liked;

          if (liked) {
            localStorage.setItem(likeKey, '1');
            likeButton.textContent = `♥ ${result.likes}`;
            likeButton.classList.add('liked');
          } else {
            localStorage.removeItem(likeKey);
            likeButton.textContent = `♡ ${result.likes}`;
            likeButton.classList.remove('liked');
          }
        
        } catch {
          // 按讚失敗時保持原數字
        } finally {
          likeButton.disabled = false;
        }
      });
      
      header.append(name, time);
      article.append(header, message, likeButton);
        if (comment.reply) {
          const reply = document.createElement('p');
          reply.className = 'comment-owner-reply';
          reply.textContent = `[Henry] ${comment.reply}`;
          article.appendChild(reply);

          const replyLikeButton = document.createElement('button');
          replyLikeButton.type = 'button';
          replyLikeButton.className = 'comment-like';
          replyLikeButton.textContent = `♡ ${comment.reply_likes}`;

          const replyLikeKey = `comment-reply-liked:${comment.id}`;
          let replyLiked = localStorage.getItem(replyLikeKey) === '1';

          if (replyLiked) {
            replyLikeButton.textContent = `♥ ${comment.reply_likes}`;
            replyLikeButton.classList.add('liked');
          }

          replyLikeButton.addEventListener('click', async () => {
            replyLikeButton.disabled = true;

            try {
            const action = replyLiked ? 'reply-unlike' : 'reply-like';

            const response = await fetch(apiUrl, {
              method: 'PATCH',
              headers: {
               'Content-Type': 'application/json'
              },
              body: JSON.stringify({
              id: comment.id,
               action
              })
            });

            const result = await response.json() as {
              reply_likes?: number;
              error?: string;
            };

            if (!response.ok || typeof result.reply_likes !== 'number') {
             throw new Error(result.error || '按讚失敗');
            }

            replyLiked = !replyLiked;

            if (replyLiked) {
              localStorage.setItem(replyLikeKey, '1');
              replyLikeButton.textContent = `♥ ${result.reply_likes}`;
              replyLikeButton.classList.add('liked');
            } else {
            localStorage.removeItem(replyLikeKey);
            replyLikeButton.textContent = `♡ ${result.reply_likes}`;
            replyLikeButton.classList.remove('liked');
            }

            } catch {
              // 按讚失敗時保持原狀
            } finally {
              replyLikeButton.disabled = false;
            }
        });

        article.appendChild(replyLikeButton);
        }
        
        if (isAdmin) {
          const replyButton = document.createElement('button');
          replyButton.type = 'button';
          replyButton.className = 'comment-reply-button';
          replyButton.textContent = comment.reply ? '修改回覆' : '回覆';

          replyButton.addEventListener('click', () => {
            if (article.querySelector('.comment-reply-form')) return;

              const replyForm = document.createElement('div');
              replyForm.className = 'comment-reply-form';

              const textarea = document.createElement('textarea');
              textarea.rows = 3;
              textarea.maxLength = 1000;
              textarea.value = comment.reply ?? '';
              textarea.placeholder = '寫下回覆';

              const sendButton = document.createElement('button');
              sendButton.type = 'button';
              sendButton.textContent = '送出';

              const cancelButton = document.createElement('button');
              cancelButton.type = 'button';
              cancelButton.textContent = '取消';

          cancelButton.addEventListener('click', () => {
          replyForm.remove();
        });

    sendButton.addEventListener('click', async () => {
      const reply = textarea.value.trim();
      if (!reply) return;

      sendButton.disabled = true;

      try {
        const response = await fetch(apiUrl, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            id: comment.id,
            action: 'reply',
            reply
          })
        });

        const result = await response.json() as {
          error?: string;
        };

        if (!response.ok) {
          throw new Error(result.error || '回覆失敗');
        }

        await loadComments();
      } catch (error) {
        alert(
          error instanceof Error
            ? error.message
            : '回覆失敗'
        );
        sendButton.disabled = false;
      }
    });

    replyForm.append(textarea, sendButton, cancelButton);
    article.appendChild(replyForm);
  });

  article.appendChild(replyButton);
}

list.appendChild(article);
    }
  } catch {
    list.textContent = '留言載入失敗，請稍後再試。';
  }
}
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const formData = new FormData(form);

      const name = String(formData.get('name') ?? '').trim();
      const message = String(formData.get('message') ?? '').trim();

      if (!name || !message) return;

      status.textContent = '送出中⋯⋯';
      if (button) button.disabled = true;

      try {
        const response = await fetch(apiUrl, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ name, message })
        });

        const result = await response.json() as {
          error?: string;
        };

        if (!response.ok) {
          throw new Error(result.error || '留言送出失敗');
        }

        form.reset();
        status.textContent = '留言已送出。';
        await loadComments();
      } catch (error) {
        status.textContent =
          error instanceof Error ? error.message : '留言送出失敗';
      } finally {
        if (button) button.disabled = false;
      }
    });

    isAdmin = await checkAdmin();
    await loadComments();
  }
</script>

<style>
  .comments {
    margin-top: 2rem;
  }


  .comments h2 {
    margin: 0 0 1.25rem;
     padding-top: 1.5rem;
     border-top: 1px solid var(--border, #d8d8d8);
    font-size: 1.25rem;
  }

  .comment-list {
    margin-bottom: 1.5rem;
  }

  .comment-loading,
  .comment-empty {
    opacity: 0.7;
  }

:global(.comment-item) {
  display: grid;
  gap: 0.4rem;
  margin-bottom: 1rem;
}

:global(.comment-item p) {
  margin: 0;
  padding: 0 0 0 0.8rem;
  border-left: 2px solid var(--border, #888);
  white-space: pre-wrap;
}

:global(.comment-like) {
  appearance: none;
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  margin: -1.5rem 0 0 0;
  justify-self: start;
  color: inherit;
  font: inherit;
  opacity: 0.65;
  cursor: pointer;
  box-shadow: none !important;
}

:global(.comment-like.liked) {
  color: #ff5c93;
  opacity: 1;
}

:global(.comment-reply-button) {
  appearance: none !important;
  -webkit-appearance: none !important;
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  margin: 0.25rem 0 0 0.8rem;
  justify-self: start;
  color: inherit;
  font: inherit;
  font-size: 1rem;
  opacity: 0.65;
  cursor: pointer;
  box-shadow: none !important;
}

:global(.comment-owner-reply) {
  margin: 0;
  padding: 0 0 0 0.8rem;
  border-left: 2px solid var(--border, #888);
  white-space: pre-wrap;
  opacity: 0.85;
}

:global(.comment-reply-form) {
  display: flex;
  align-items: flex-end;
  gap: 0.5rem;
  margin: 0.5rem 0 0.75rem 0;
  width: 100%;
}

:global(.comment-reply-form textarea) {
  width: 100%;
  min-height: 5rem;
  box-sizing: border-box;
  padding: 0.7rem 0.8rem;
  font: inherit;
  font-size: 1rem;
  line-height: 1.6;
  color: inherit;
  background: transparent;
  border: 1px solid var(--border, #aaa);
  border-radius: 6px;
  resize: vertical;
}

:global(.comment-reply-form button) {
  flex: 0 0 auto;
  padding: 0.55rem 0.8rem;
  font: inherit;
  font-size: 1rem;
  cursor: pointer;
}

  :global(.comment-header) {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }

  :global(.comment-header time) {
    font-size: 0.85rem;
    opacity: 0.6;
  }


  .comment-form {
    display: grid;
    gap: 1rem;
  }

  .comment-form label {
    display: grid;
    gap: 0.1rem;
  }

  .comment-form input,
  .comment-form textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.8rem;
    font: inherit;
    color: inherit;
    background: transparent;
    border: 1px solid var(--border, #aaa);
    border-radius: 6px;
  }

  .comment-form textarea {
    resize: vertical;
  }

  .comment-submit-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }

  .comment-status {
    font-size: 0.9rem;
    opacity: 0.75;
  }

  .comment-form button {
    padding: 0.55rem 1rem;
    font: inherit;
    cursor: pointer;
  }

  .comment-form button:disabled {
    cursor: default;
    opacity: 0.5;
  }

/* Henry 管理操作按鈕 */
:global(.comment-reply-button),
:global(.comment-reply-form button) {
  appearance: none !important;
  -webkit-appearance: none !important;

  background: #1f5a43 !important;
  border: 1px solid #2f8a63 !important;
  border-radius: 4px;

  color: #fff !important;

  padding: 0.35rem 0.7rem !important;
  font: inherit;
  font-size: 0.9rem;

  opacity: 1;
  cursor: pointer;
  box-shadow: none !important;
}

/* 滑鼠移上去稍微亮一點 */
:global(.comment-reply-button:hover),
:global(.comment-reply-form button:hover) {
  background: #287454 !important;
  border-color: #43a979 !important;
}
</style>