---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles.css';
const { title = 'Henry Chen 的隨筆', description = '閱讀、旅行，以及台灣與世界的觀察。', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
import SourceCapture from '../components/SourceCapture.astro';
---
<!doctype html>
<html lang="zh-Hant" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonical} />

  <link rel="icon" href="/icons/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#172328" />
  
  <title>{title}</title>
  <script is:inline>
    (() => {
      const saved = localStorage.getItem('theme');
      document.documentElement.dataset.theme = saved || 'dark';
    })();
  </script>
</head>

<body>
  <a class="skip-link" href="#main">跳至主要內容</a>
  <Header />
  <main id="main"><slot /></main>
  <Footer />

  <!-- Cloudflare Web Analytics -->
  <script
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon='{"token":"19d6ce16be3f44209410daa4913c752b"}'>
  </script>
  <!-- End Cloudflare Web Analytics -->
  <SourceCapture />
</body>
</html>
