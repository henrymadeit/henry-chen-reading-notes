---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import type { Article } from '../lib/articles';
import { categoryPaths, dateFormatter } from '../lib/articles';
const { article, related } = Astro.props as { article: Article; related: Article[] };
---
<BaseLayout title={`${article.data.title} | Henry Chen 的隨筆`} description={article.data.description}>
  <article class="article-shell" data-pagefind-body>
    <header class="article-header">
      <div class="article-header-grid">
        <div class="article-header-text">
          <a class="eyebrow" href={categoryPaths[article.data.category]}>{article.data.category}</a>
          <h1 data-pagefind-meta="title">{article.data.title}</h1>
          <p class="dek">{article.data.description}</p>

          <div class="article-meta">
            <time datetime={article.data.published.toISOString()}>{dateFormatter.format(article.data.published)}</time>
            {article.data.readingNumber && <span>閱讀（{article.data.readingNumber}）</span>}
            {article.data.bookAuthor && <a href={`/authors/${encodeURIComponent(article.data.bookAuthor)}/`}>作者：{article.data.bookAuthor}</a>}
          </div>

          <div class="tag-row">
            {article.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}
          </div>
          
          {article.data.note && (
            <p class="article-note">
             {article.data.note}
            </p>
          )}
          
          </div>

        {article.data.cover && (
          <div class="article-cover-wrap">
           <img class="article-cover" src={article.data.cover} alt={`${article.data.title} 書封`} />
           
           {article.data.coverCaption && (
            <p class="cover-caption">{article.data.coverCaption}</p>
            )}
          </div>
        )}
      </div>
    </header>

    <div class="prose"><slot /></div>
  </article>
  {related.length > 0 && <aside class="related wrap"><h2>相關文章</h2><div class="card-grid">{related.map((item) => <ArticleCard article={item} compact showLikes={true} />)}</div></aside>}
</BaseLayout>
