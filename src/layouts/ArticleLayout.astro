---
import BaseLayout from './BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import type { Article } from '../lib/articles';
import { categoryPaths, dateFormatter } from '../lib/articles';
const { article, related } = Astro.props as { article: Article; related: Article[] };
---
<BaseLayout title={`${article.data.title}｜Henry Chen 的隨筆`} description={article.data.description}>
  <article class="article-shell" data-pagefind-body>
    <header class="article-header">
      <a class="eyebrow" href={categoryPaths[article.data.category]}>{article.data.category}</a>
      <h1 data-pagefind-meta="title">{article.data.title}</h1>
      <p class="dek">{article.data.description}</p>
      <div class="article-meta">
        <time datetime={article.data.published.toISOString()}>{dateFormatter.format(article.data.published)}</time>
        {article.data.readingNumber && <span>閱讀（{article.data.readingNumber}）</span>}
        {article.data.bookAuthor && <a href={`/authors/${encodeURIComponent(article.data.bookAuthor)}/`}>作者：{article.data.bookAuthor}</a>}
      </div>
      <div class="tag-row">{article.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div>
    </header>
    {article.data.takeaway && (
      <blockquote class="takeaway">
        <div class="takeaway-title">我的一句話</div>
        {article.data.takeaway}
      </blockquote>
    )}
    <div class="prose"><slot /></div>
  </article>
  {related.length > 0 && <aside class="related wrap"><h2>相關文章</h2><div class="card-grid">{related.map((item) => <ArticleCard article={item} compact />)}</div></aside>}
</BaseLayout>
